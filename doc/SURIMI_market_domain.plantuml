@startuml
' Core classes
class Tick {
  +tick: int
  +start_time: datetime
  +increase_tick(): void
  +get_tick(): int
  +get_timestamp(): str
}

class Species {
  -name: str
  -id: str
}

class Market {
  -tick: Tick
  -ports_dict: Dict[str, Port]
  -species_dict: Dict[str, Species]
  -currency: str
  -measurement_unit: str
  -global_market: GlobalMarket
  +add_port(name: str, id: str)
  +add_species(name: str, id: str)
  +set_local_market_parameters(...)
  +catch_by_species(...)
  +calculate_species_price(): float
  +update_species_prices_message()
}

class Port {
  -name: str
  -id: str
  -local_market: LocalMarket
  -global_market: GlobalMarket
}

class GlobalMarket {
  -prices: Dict[str, float]
  +set_price(id: str, price: float)
  +get_price(id: str): float
}

class LocalMarket {
  -port_id: str
  -parent_model: Market
  -species_price_params: Dict
  -monthly_catch: Dict[str, float]
  +set_price_parameters(...)
  +record_landing(...)
  +calculate_price(...): float
  +get_elasticity(...): float
}

' Relationships
Market --> Tick
Market --> "0..*" Port
Market --> "0..*" Species
Market --> GlobalMarket
Port --> LocalMarket
Port --> GlobalMarket
LocalMarket --> Market
GlobalMarket --> "0..*" Species
LocalMarket --> "0..*" Species

@enduml